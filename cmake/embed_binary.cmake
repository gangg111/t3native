# Writes OUT, a C++ source with the bytes of FILE as `const unsigned char NAME[]` and
# `const unsigned long NAME_size` (namespace t3::embedded).
file(READ "${FILE}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR size "${length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
set(body "// Generated by cmake/embed_binary.cmake from ${FILE}: do not edit.\nnamespace t3::embedded {\nextern const unsigned char ${NAME}[] = {\n${bytes}\n};\nextern const unsigned long ${NAME}_size = ${size};\n}  // namespace t3::embedded\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${body}")
  file(WRITE "${OUT}" "${body}")
endif()
