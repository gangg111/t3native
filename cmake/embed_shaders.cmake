# Writes OUT, a C++ source with every file under DIR (*.gdshader, *.gdshaderinc) as a raw string,
# keyed by its `res://` path, for gfx3d::shader_source().
file(GLOB_RECURSE files RELATIVE "${DIR}" "${DIR}/*.gdshader" "${DIR}/*.gdshaderinc")
list(SORT files)
set(body "// Generated by cmake/embed_shaders.cmake from shaders/: do not edit.\n#include \"gfx3d/shader_sources.h\"\n\nnamespace t3::gfx3d {\n\nconst std::map<std::string, std::string>& shader_sources() {\n    static const std::map<std::string, std::string> sources = {\n")
foreach(f ${files})
  file(READ "${DIR}/${f}" text)
  string(APPEND body "        {\"res://${f}\", R\"gdshader(${text})gdshader\"},\n")
endforeach()
string(APPEND body "    };\n    return sources;\n}\n\n}  // namespace t3::gfx3d\n")
# Only rewritten when it changes, so an unchanged shader set does not rebuild the library.
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${body}")
  file(WRITE "${OUT}" "${body}")
endif()
